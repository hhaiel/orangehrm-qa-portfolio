# Copy to docker/.env and fill in. docker/.env is git-ignored.
# Local test values only. Never reuse a real password here.

# Database (used by docker-compose.yml and entered in the install wizard)
DB_NAME=orangehrm
DB_USER=orangehrm
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# App
APP_PORT=8080

# OrangeHRM admin account created in the install wizard
ADMIN_USERNAME=qa_admin
ADMIN_PASSWORD=change-me-Admin1

# ESS test users (created during test data setup, see docs/test-data.md)
EMP_USERNAME=qa_av_emp
SUPER_USERNAME=qa_av_super
DISABLED_USERNAME=qa_av_disabled
OTHER_USERNAME=qa_av_other
TEST_USER_PASSWORD=change-me-User1
